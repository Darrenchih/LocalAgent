{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "本機 AI 助理",
  "version": "0.37.0",
  "identifier": "local.ollama.agent",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "本機 AI 助理",
        "width": 1280,
        "height": 820,
        "minWidth": 880,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "externalBin": [
      "binaries/agent-core",
      "binaries/agent-discovery"
    ],
    "resources": {
      "binaries/protected-runtime/": "runtime/protected/localagent-management-v1/",
      "binaries/agent-broker/": "runtime/agent/localagent-agent-test-v1/",
      "../../packaging/release-notices-final/": "notices/"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "本機 AI 助理",
        "languages": [
          "English",
          "TradChinese",
          "SimpChinese"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "../../packaging/installer-hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "skip"
      }
    },
    "licenseFile": "../../packaging/INSTALLATION_NOTICE.txt"
  }
}
